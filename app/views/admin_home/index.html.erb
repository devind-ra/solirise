<div class="container">
    <h1>Welcome to the Admin Dashboard</h1>
    <hr>
    <br><br>
    <div class="row mt-4">
      <div class="col-md-4">
        <div class="card">
          <div class="card-body">
            <h2 class="card-title">User Appraisals</h5>
            <p class="card-text">View and manage all user appraisals here.</p>
            <%= link_to 'Go to User Appraisals', admin_view_appraisals_path, class: 'btn btn-primary', aria: { label: 'Go to User Appraisals Page' } %>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card">
          <div class="card-body">
            <h2 class="card-title">User Goals</h5>
            <p class="card-text">View all user goals here.</p>
            <%= link_to 'Go to User Goals', admin_view_goals_path, class: 'btn btn-primary', aria: { label: 'Go to User Goals Page' }  %>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card">
          <div class="card-body">
            <h2 class="card-title">Create Appraisal</h5>
            <p class="card-text">Create appraisal form for a user to fill out.</p>
            <%= link_to 'Create Appraisal', new_appraisal_path, class: 'btn btn-primary', aria: { label: 'Go to Create Appraisal Page' }  %>
          </div>
        </div>
      </div>
    </div>
</div>