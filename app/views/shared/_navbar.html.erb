        <%= button_to switch_to_user_path, method: :post, class: "mt-2 me-2 mb-2 ms-5 btn btn-secondary" do %>
          <i class="bi bi-arrow-left-right"></i> User
        <% end %>
      <% else %>
        <%= button_to switch_to_admin_path, method: :post, class: "mt-2 me-2 mb-2 ms-5 btn btn-secondary" do %>
          <i class="bi bi-arrow-left-right"></i> Admin
        <% end %>
      <% end %>
    <% end %>
