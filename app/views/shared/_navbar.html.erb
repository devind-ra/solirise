      <%= link_to edit_user_registration_path, aria: { label: "Edit Profile" }  do %>
        <i class="bi bi-gear-fill fs-2 mb-2"></i>
      <% end %>
    </div>
    <% if user_signed_in? %> 
      <div class="nav-link ms-2 mt-2">
        <%= button_to destroy_user_session_path, method: :delete, class: "nav-link ms-2 mt-2", aria: { label: "Sign out" }  do %>
