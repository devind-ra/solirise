      <% if session[:admin_mode] %>
        <%= link_to "All User Appraisals", admin_view_appraisals_path, class: "btn btn-info btn-me me-2" %>
        <%= link_to "All User Goals", admin_view_goals_path, class: "btn btn-info btn-me me-2" %>
      <% else %>
        <%= link_to "All Appraisals", view_all_appraisals_path, class: "btn btn-info btn-me me-2" %>
        <%= link_to "My Goals", goals_path, class: "mr-2 btn btn-info btn-me" %>
      <% end %>
    </div>
  </div>
  <div class="d-flex me-3">
    <% if current_user.admin? %>
