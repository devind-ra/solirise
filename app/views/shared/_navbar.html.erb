<nav class="navbar navbar-expand-lg bg-body-tertiary">
  <div class="container-fluid">
    <a class="navbar-brand" href="<%= home_path %>">
      SoliRise
    </a>
  </div>
  <div class="d-flex me-3">
    <% if current_user.admin? %>
      <% if request.path == admin_home_index_path %>
          <%= link_to "Switch to User View", home_path, class: "mt-2 me-2 mb-2 ms-5 btn btn-outline-primary" %>
      <% else %>
          <%= link_to "Switch to Admin View", admin_home_index_path, class: "mt-2 me-2 mb-2 ms-5 btn btn-outline-primary" %>
      <% end %>
    <% end %>
    <% if user_signed_in? %> 
      <div class="mt-3 me-2 mb-2 text-center" > Welcome <%= current_user.full_name %> </div> 
      <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "mt-2 me-2 mb-2 btn btn-outline-primary ms-4" %>
    <% end %>
  </div>
</nav>