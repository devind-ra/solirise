<div class='container'>
  <div>
    <% if session[:admin_mode] %>
        <%= link_to "Back to Admin Home", admin_home_index_path, class: "btn btn-primary", aria: { label: "Go back to Admin Home Page" } %>
    <% else %>
        <%= link_to "Back to Home", home_path, class: "btn btn-secondary", aria: { label: "Go back to Home Page" } %>
    <% end %>
  </div>
  <br>
  <div>
    <%= link_to "Download as PDF", download_appraisal_entry_path(@appraisal, @entry, format: :pdf), class: "btn btn-primary", target: "_blank", rel: "noopener noreferrer", aria: { label: "Download this appraisal entry as a PDF document. This will open in a new tab." } %>
  </div>
  <h1 class='mt-5'>Appraisal Entry</h1>
  <% if @appraisal %>
    <% grouped_categories = @categories.group_by(&:page) %>
    <% grouped_categories.each do |page, categories| %>
      <h2>Section <%= page %></h2>

      <% categories.each do |category| %>
        <h3><%= category.name %></h3>

        <ul>
          <% category.questions.each do |question| %>
            <li><%= question.content %></li>
          <% end %>
        </ul>

        <div class="mb-3">
          <% case category.page %>
          <% when 1 %>
            <p><strong>Yes/No/Partial</strong></p>
          <% end %>

          <textarea class="form-control" id="answers_<%= category.id %>" rows="4" disabled aria-label="Answer for category <%= category.name %>"><%= @entry.answers&.[](category.id.to_s) || "No answer provided"%></textarea>
        </div>
      <% end %>
    <% end %>
  <% else %>
    <p>No entries found for this appraisal.</p>
  <% end %>

  <br>
  <div>
    <% if session[:admin_mode]%>
      <%= link_to "Back to Admin Home", admin_home_index_path, class: "btn btn-primary", aria: { label: "Go back to Admin Home Page" } %>
    <% else %>
      <%= link_to "Back to Home", home_path, class: "btn btn-secondary", aria: { label: "Go back to the Home Page" } %>
    <% end %>
  </div>
  <br><br>
</div>