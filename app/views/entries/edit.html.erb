<div class='container'>
  <div>
    <%= link_to "Back to Home", home_path, class: "btn btn-primary"%>
  </div>
  <h1 class='mt-5'>Appraisal Entry</h1>

  <%= form_with(model: [@appraisal, @entry], local: true) do |form| %>
    <% grouped_categories = @categories.group_by(&:page) %>
    <% grouped_categories.each do |page, categories| %>
      <h2>Section <%= page %></h2>

      <% categories.each do |category| %>
        <h3><%= category.name %></h3>

        <ul>
          <% category.questions.each do |question| %>
            <li><%= question.content %></li>
          <% end %>
        </ul>

        <div class="mb-3">
          <% case category.page %>
          <% when 1 %>
            <p><strong>Yes/No/Partial</strong></p>
          <% end %>

          <%= form.text_area nil, name: "entry[answers][#{category.id}]", class: "form-control", id: "answers_#{category.id}", rows: 4, placeholder: "Add your answer here", value: @entry.answers[category.id.to_s] || "" %>
        </div>
      <% end %>
    <% end %>
    <div>
      <%= form.submit "Update", class: "btn btn-primary" %>
    </div>
  <% end %>

  <br>
  <div>
    <%= link_to "Back to Home", home_path, class: "btn btn-primary" %>
  </div>
  <br><br>
</div>