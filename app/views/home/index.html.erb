<div class="container">
  <h1>Home</h1>
  <br>
  <h2>Pending Appraisals</h2>
  <br>
  <% if @pending_appraisals.any? %>
    <ul class="list-group mb-4">
      <% @pending_appraisals.each do |appraisal| %>
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <div>
            <strong><%= appraisal.title %></strong><br>
          </div>
          <%= link_to "Start Entry", new_appraisal_entry_path(appraisal), class: "btn btn-success" %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p>No pending appraisals 🎉</p>
    <br>
  <% end %>

  <h2>All Appraisals</h2>
  <br>
  
  <% if @appraisals.any? %>
    <table class="table">
      <thead>
        <tr>
          <th>Created At</th>
          <th>Edit Action</th>
          <th>View Action</th>
        </tr>
      </thead>
      <tbody>
        <% @appraisals.each do |appraisal| %>
          <tr>
            <% last_entry = appraisal.entries.last %>
            <td><%= appraisal.updated_at.strftime("%B %d, %Y at %I:%M %p") %></td>
            <td>
              <% if last_entry %>
                <%= link_to 'Edit Last Entry', edit_appraisal_entry_path(appraisal, last_entry), class: 'btn btn-primary' %>
              <% else %>
                <p>No entries available for this appraisal.</p>
              <% end %>
            </td>
            <td>
              <% if last_entry %>
                <%= link_to 'View Last Entry', view_appraisal_entry_path(appraisal, last_entry), class: 'btn btn-secondary' %>
              <% else %>
                <p>No entries available for this appraisal.</p>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>No appraisals found.</p>
  <% end %>
</div>
