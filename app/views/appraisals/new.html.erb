<div class="container">
    <h2>New Appraisal</h2>

    <%= form_with model: @appraisal, url: appraisals_path do |f| %>
    <div class="mb-3">
        <%= label_tag :user_id, "Select User From Dropdown" %>
        <%= select_tag :user_id, options_from_collection_for_select(
            User.order(:first_name, :last_name), 
            :id, 
            ->(user) { "#{user.first_name} #{user.last_name} (#{user.email})" }
        ), include_blank: true, class: "form-select" %>
    </div>

    <div class="mb-3">
        <%= f.label :title %>
        <%= f.text_field :title, class: "form-control" %>
    </div>

    <%= f.submit "Create Appraisal", class: "btn btn-success" %>
    <% end %>
    <br>
    <%= link_to "Back to Admin Home", admin_home_index_path, class: "btn btn-secondary" %>
</div>