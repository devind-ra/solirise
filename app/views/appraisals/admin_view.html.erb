<div class="container">
    <div>
        <%= link_to "Back to Admin Home", admin_home_index_path, class: "btn btn-secondary", aria: { label: "Go Back to Admin Home Page" } %>
    </div>
    <br>
    <h1>All User Appraisals</h1>
    <br>

    <%= form_with url: admin_view_appraisals_path, method: :get, local: true do %>
      <div class="form-group">
        <%= label_tag :user_id, "Filter by User", aria: { label: 'Filter appraisals by user' } %>
        <%= select_tag :user_id, options_for_select(
          User.all.map { |u| ["#{u.full_name} (#{u.email})", u.id] },
          params[:user_id]
        ), include_blank: "All Users", class: "form-control", aria: { label: 'Dropdown to select a user' }  %>
      </div>
      <%= submit_tag "Filter", class: "btn btn-primary mt-2", aria: { label: 'Apply filter to appraisals' }  %>
    <% end %>
    <br>

    <% if @appraisals.any? %>
    <table class="table">
      <thead>
        <tr>
          <th>Appraisal Title</th>
          <th>User</th>
          <th>Updated At</th>
          <th>Delete Action</th>
          <th>View Action</th>
        </tr>
      </thead>
      <tbody>
        <% @appraisals.each do |appraisal| %>
          <tr>
            <td><%= appraisal.title %></td>
            <td><%= "#{appraisal.user.first_name} #{appraisal.user.last_name}" %></td>
            <% last_entry = appraisal.entries.last %>
            <td><%= appraisal.updated_at.strftime("%B %d, %Y at %I:%M %p") %></td>
            <td>
              <%= button_to 'Delete', appraisal_path(appraisal), method: :delete, class: 'btn btn-danger', aria: { label: "Delete appraisal titled #{appraisal.title}" } %>
            </td>
            <td>
              <% if last_entry %>
                <%= link_to 'View Entry', view_appraisal_entry_path(appraisal, last_entry), class: 'btn btn-secondary', aria: { label: "View the latest entry for appraisal titled #{appraisal.title}" } %>
              <% else %>
                <p>No entry available for this appraisal.</p>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>No appraisals found.</p>
  <% end %>
</div>