<div class="container">
    <div>
        <%= link_to "Back to Home", home_path, class: "btn btn-secondary", aria: { label: "Go back to Home Page" } %>
    </div>
    <br>
    <h1>All Appraisals</h1>
    <br>

    <% if @appraisals&.any? %>
    <table class="table">
        <thead>
        <tr>
            <th>Appraisal Title</th>
            <th>Updated At</th>
            <th>Edit Action</th>
            <th>View Action</th>
        </tr>
        </thead>
        <tbody>
        <% most_recent_appraisal = @appraisals.max_by(&:created_at) %>
        <% @appraisals.each do |appraisal| %>
            <tr>
            <td><%= appraisal.title %></td>
            <% last_entry = appraisal.entries.last %>
            <td><%= appraisal.updated_at.strftime("%B %d, %Y at %I:%M %p") %></td>
            <td>
                <% if appraisal == most_recent_appraisal && last_entry %>
                    <%= link_to 'Edit Entry', edit_appraisal_entry_path(appraisal, last_entry), class: 'btn btn-primary', aria: { label: "Edit the most recent entry for appraisal" }  %>
                <% elsif appraisal == most_recent_appraisal %>
                    <p>No entry available to edit.</p>
                <% end %>
            </td>
            <td>
                <% if last_entry %>
                <%= link_to 'View Entry', view_appraisal_entry_path(appraisal, last_entry), class: 'btn btn-secondary', aria: { label: "View the latest entry for appraisal titled #{appraisal.title}" }  %>
                <% else %>
                <p>No entry available for this appraisal.</p>
                <% end %>
            </td>
            </tr>
        <% end %>
        </tbody>
    </table>
    <% else %>
    <p>No appraisals found.</p>
    <% end %>
</div>