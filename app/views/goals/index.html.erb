<div class="container">
    <%= link_to "Back to Home", home_path, class: "btn btn-secondary mb-3" %>
    <h1>Goals</h1>
    <%= link_to "Add New Goal", new_goal_path, class: "btn btn-primary mb-3" %>

    <% @goals.each do |goal| %>
        <div class="card mb-3 p-3">
            <h4><%= goal.title %></h4>
                <p><%= goal.description %></p>

            <div class="progress mb-2" style="height: 20px;">
                <div class="progress-bar bg-success" role="progressbar" style="width: <%= goal.progress || 0 %>%;">
                    <%= goal.progress || 0 %>%
                </div>
            </div>
            <div class="d-flex justify-content-start">
                <%= link_to "Edit", edit_goal_path(goal), class: "btn btn-sm btn-outline-secondary me-2" %>
                <%= button_to "Delete", goal_path(goal), method: :delete, class: "btn btn-sm btn-outline-danger" %>
            </div>
        </div>
    <% end %>
</div>