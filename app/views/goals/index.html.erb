<div class="container">
    <%= link_to "Back to Home", home_path, class: "btn btn-secondary mb-3", aria: { label: "Go back to Home Page" } %>
    <h1>Goals</h1>
    <%= link_to "Add New Goal", new_goal_path, class: "btn btn-primary mb-3", aria: { label: "Go to Add New Goal Page" } %>

    <% @goals.each do |goal| %>
        <div class="card mb-3 p-3">
            <h2><%= goal.title %></h2>
                <p><%= goal.description %></p>

            <div class="progress mb-2" style="height: 20px;">
                <div class="progress-bar bg-success" role="progressbar" style="width: <%= goal.progress || 0 %>%;">
                    <%= goal.progress || 0 %>%
                </div>
            </div>
            <div class="d-flex justify-content-start">
                <%= link_to "Edit", edit_goal_path(goal), class: "btn btn-sm btn-secondary me-2", aria: { label: "Go to Edit Goal Page" } %>
                <%= button_to "Delete", goal_path(goal), method: :delete, class: "btn btn-sm btn-danger", aria: { label: "Delete Goal" } %>
            </div>
        </div>
    <% end %>
</div>