<div class="container">
  <div>
    <%= link_to "Back to Admin Home", admin_home_index_path, class: "btn btn-secondary", aria: { label: "Go back to Admin Home Page" } %>
  </div>
  <br>
  <h1>All User Goals</h1>
  <br>

  <%= form_with url: admin_view_goals_path, method: :get, local: true do %>
    <div class="form-group">
      <%= label_tag :user_id, "Filter by User", aria: { label: "Filter goals by user" } %>
      <%= select_tag :user_id, options_for_select(
          User.all.map { |u| ["#{u.full_name} (#{u.email})", u.id] },
          params[:user_id]
        ), include_blank: "All Users", class: "form-control filter-field", aria: { label: "Dropdown to select a user" } %>
    </div>
    <%= submit_tag "Filter", class: "btn btn-primary mt-2", aria: { label: "Apply filter for user goals"} %>
  <% end %>
  <br>

  <% if @goals.any? %>
    <table class="table">
      <thead>
        <tr>
          <th>Goal Title</th>
          <th>Goal Description</th>
          <th>User</th>
          <th>Progress</th>
          <th>Updated At</th>
        </tr>
      </thead>
      <tbody>
        <% @goals.each do |goal| %>
          <tr>
            <td><%= goal.title %></td>
            <td><%= goal.description %></td>
            <td><%= "#{goal.user.first_name} #{goal.user.last_name}" %></td>
            <td><%= "#{goal.progress}%" %></td>
            <td><%= goal.updated_at.strftime("%B %d, %Y at %I:%M %p") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>No goals found.</p>
  <% end %>
</div>